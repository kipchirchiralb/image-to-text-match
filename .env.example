# Copy this file to .env and fill in your own values.
# Never commit .env: it holds your API key.

# Web server port
PORT=3000

# TextSMS (https://textsms.co.ke) credentials, from your TextSMS dashboard.
TEXTSMS_API_KEY=your_textsms_api_key_here
TEXTSMS_PARTNER_ID=your_partner_id_here

# Approved sender ID / shortcode on your TextSMS account.
TEXTSMS_SENDER_ID=

# Country code used to convert local numbers like 0712345678 to +254712345678.
# Leave empty to require international format (+254...).
DEFAULT_COUNTRY_CODE=254
